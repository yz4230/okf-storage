{{ define "base" }}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Title }} · okf-storage</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📚</text></svg>">
    <script>
      document.documentElement.dataset.bsTheme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
      .markdown-body { overflow-wrap: break-word; }
      .markdown-body > :last-child { margin-bottom: 0; }
      .markdown-body h1, .markdown-body h2, .markdown-body h3 { margin-top: 1.5rem; }
      .markdown-body > h1:first-child, .markdown-body > h2:first-child { margin-top: 0; }
      .markdown-body table { margin-bottom: 1rem; border-collapse: collapse; display: block; overflow-x: auto; }
      .markdown-body th, .markdown-body td { border: 1px solid var(--bs-border-color); padding: .375rem .75rem; }
      .markdown-body pre { background: var(--bs-tertiary-bg); padding: 1rem; border-radius: var(--bs-border-radius); }
      .markdown-body blockquote { border-left: .25rem solid var(--bs-border-color); padding-left: 1rem; color: var(--bs-secondary-color); }
      .markdown-body img { max-width: 100%; }
      .markdown-body .footnotes { font-size: .875em; color: var(--bs-secondary-color); }
      .frontmatter th { width: 1%; white-space: nowrap; }
      .frontmatter pre { margin: 0; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <nav class="navbar bg-body-tertiary border-bottom">
      <div class="container gap-3">
        <a class="navbar-brand" href="/">📚 okf-storage</a>
        <form class="d-flex flex-grow-1" role="search" action="/search" method="get" style="max-width: 24rem">
          <input class="form-control" type="search" name="q" value="{{ .Query }}" placeholder="Search document bodies" aria-label="Search">
        </form>
      </div>
    </nav>
    <main>
      {{ template "content" . }}
    </main>
  </body>
</html>
{{ end }}

{{ define "crumbs" }}
<nav aria-label="breadcrumb">
  <ol class="breadcrumb mb-2">
    {{ range . }}
    {{ if .Href }}
    <li class="breadcrumb-item"><a class="link-secondary text-decoration-none" href="{{ .Href }}">{{ .Name }}</a></li>
    {{ else }}
    <li class="breadcrumb-item active" aria-current="page">{{ .Name }}</li>
    {{ end }}
    {{ end }}
  </ol>
</nav>
{{ end }}

{{ define "entries" }}
<div class="list-group list-group-flush">
  {{ range . }}
  <a class="list-group-item list-group-item-action d-flex gap-3 align-items-start py-3" href="{{ .Href }}">
    <span aria-hidden="true">{{ if .IsDir }}📁{{ else if .IsDoc }}📄{{ else }}📎{{ end }}</span>
    <span class="flex-grow-1 min-w-0">
      <span class="d-flex flex-wrap align-items-baseline gap-2">
        <span class="fw-semibold">{{ if .Title }}{{ .Title }}{{ else }}{{ .Name }}{{ if .IsDir }}/{{ end }}{{ end }}</span>
        {{ if .Title }}<code class="small text-body-secondary">{{ .Path }}</code>{{ end }}
        {{ if .Type }}<span class="badge text-bg-secondary">{{ .Type }}</span>{{ end }}
        {{ if .Invalid }}<span class="badge text-bg-danger">invalid</span>{{ end }}
      </span>
      {{ if .Description }}<span class="d-block small text-body-secondary mt-1">{{ .Description }}</span>{{ end }}
    </span>
  </a>
  {{ end }}
</div>
{{ end }}
